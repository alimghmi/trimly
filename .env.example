DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

TRIMLY_BASE_URL=http://localhost:8000

DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=0

# Postgres (unset to fall back to SQLite)
# POSTGRES_DB=trimly
# POSTGRES_USER=trimly
# POSTGRES_PASSWORD=trimly
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Redis cache (unset to fall back to in-process locmem)
# REDIS_URL=redis://cache:6379/0

TRIMLY_CODE_LENGTH=5
TRIMLY_ALLOWED_SCHEMES=http,https
TRIMLY_CACHE_TTL=86400
TRIMLY_WRITE_RATE=60/min

# Production
# DJANGO_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(64))">
# DJANGO_ALLOWED_HOSTS=trimly.example.com
# TRIMLY_BASE_URL=https://trimly.example.com
# POSTGRES_DB=trimly
# POSTGRES_USER=trimly
# POSTGRES_PASSWORD=<strong password>
# GUNICORN_WORKERS=3
# WEB_REPLICAS=1
